from kafka import KafkaConsumer, KafkaProducer
import ssl

LOCAL_TOPICS = [
    "energy.public.facilities",
    "energy.public.meter_readings",
    "energy.public.investments"
]

TOPIC_MAP = {
    "energy.public.facilities": "cisaf.facilities",
    "energy.public.meter_readings": "cisaf.meter_readings",
    "energy.public.investments": "cisaf.investments",
}

consumer = KafkaConsumer(
    *LOCAL_TOPICS,
    bootstrap_servers="localhost:29092",
    auto_offset_reset="earliest",
    group_id="redpanda-bridge",
    enable_auto_commit=True
)

producer = KafkaProducer(
    bootstrap_servers="d6sinugbmgg6innos300.any.eu-central-1.mpx.prd.cloud.redpanda.com:9092",
    security_protocol="SASL_SSL",
    sasl_mechanism="SCRAM-SHA-256",
    sasl_plain_username="energy-compliance-user",
    sasl_plain_password="energypass123",
    ssl_context=ssl.create_default_context()
)

print("Starting bridge...")
count = 0
for msg in consumer:
    target_topic = TOPIC_MAP.get(msg.topic, msg.topic)
    producer.send(target_topic, key=msg.key, value=msg.value)
    count += 1
    if count % 1000 == 0:
        print(f"Forwarded {count} messages | latest: {target_topic}:{msg.offset}")
        producer.flush()

producer.flush()
print(f"Bridge complete. Total forwarded: {count}")
